#!/usr/bin/env sh

msg=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' "$1")

# Forbid AI agents to write "Generated by" to commit message
if printf '%s\n' "$msg" | grep -q 'Generated by'; then
    echo 'commit-msg: remove the "Generated by" line from the commit message.' >&2
    exit 1
fi

subject=$(printf '%s\n' "$msg" | grep -m1 '[^[:space:]]')
case $subject in
    '' | 'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|release|revert|style|test|harness'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([^()[:space:]]+\))?!?: [^[:space:]]"; then
    cat >&2 <<EOF
commit-msg: the subject must be "<type>[(scope)][!]: <description>".
    types: $(printf "%s\n" "$types" | tr '|' ' ')
    e.g    feat(compose): mount the team folder read-only
    got:   $subject
EOF
    exit 1
fi
