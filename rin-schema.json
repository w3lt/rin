{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rin Swarm Agent Configuration",
  "description": "Declarative configuration for a cluster of Rin swarm agent. Rin Tohsaka is the best waifu btw",
  "type": "object",
  "additionalProperties": false,
  "required": ["rin", "name", "agents", "version"],
  "properties": {
    "rin": {
      "type": "string",
      "const": "tohsaka"
    },
    "name": {
      "type": "string",
      "description": "The name of workspace, you can use multiple workspace with Rin",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of your waifu (cli) Rin Tohsaka, must be exact as the version of cli you are running, rin generate refuses to run otherwise. Images are built from this version, so everyone on the team gets the same setup."
    },
    "messaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*m$",
          "default": "30m"
        },
        "maxHops": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent"
      },
      "contains": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "const": "leader"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "llmProviders": {
      "type": "array",
      "description": "Extra LLM providers , besides the built-in openai, anthropic, google and ollama (Ollama Cloud). A harness can use one with model: <id>/<model>.",
      "items": {
        "$ref": "#/$defs/llmProvider"
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "resources",
        "harness",
        "authentication",
        "model"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "not": {
            "enum": ["user", "hub", "bifrost", "localhost"]
          }
        },
        "type": {
          "enum": ["leader", "member"]
        },
        "label": {
          "type": "string",
          "description": "Like AI Engineer or Universe Engineer or some cool fancy title you can imagine"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "harness": {
          "enum": ["claude-code", "codex", "antigravity", "pi"]
        },
        "authentication": {
          "enum": ["subscription", "apiKey"]
        },
        "model": {
          "type": "string"
        },
        "maxSessions": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        }
      },
      "if": {
        "properties": {
          "harness": {
            "const": "pi"
          }
        },
        "required": ["harness"]
      },
      "then": {
        "properties": {
          "authentication": {
            "const": "apiKey"
          }
        },
        "required": ["authentication"]
      }
    },
    "llmProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "baseUrl", "apiKeyRequired"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Identifier of the provider; a model will be under the form: <id>/<model>. openai, anthropic, google and ollama are built in.",
          "not": {
            "enum": ["openai", "anthropic", "google", "ollama"]
          }
        },
        "type": {
          "description": "The API the provider speaks. openai: OpenAI chat completions.",
          "enum": ["openai"]
        },
        "baseUrl": {
          "type": "string",
          "description": "The base url of the provider. Use your eyes to read the provider's documentation please",
          "pattern": "^https?://[^\\s/?#]+(/[^\\s?#]*)?$"
        },
        "apiKeyRequired": {
          "type": "boolean",
          "description": "Whether the provider needs an API key: usually true for cloud providers, false for local ones."
        },
        "apiKeyEnv": {
          "type": "string",
          "description": "The variable in keys.env that holds the provider's API key. Required when apiKeyRequired is true, not allowed otherwise.",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "not": {
            "pattern": "^(BIFROST|RIN)_"
          }
        }
      },
      "if": {
        "properties": {
          "apiKeyRequired": {
            "const": true
          }
        },
        "required": ["apiKeyRequired"]
      },
      "then": {
        "required": ["apiKeyEnv"]
      },
      "else": {
        "not": {
          "required": ["apiKeyEnv"]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpus", "ram"],
      "properties": {
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "CPU limit for the agent's container, in cores (Compose cpus), e.g. 2 or 0.5"
        },
        "ram": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[mg]$",
          "description": "Memory limit for the agent's container (Compose mem_limit), e.g. 512m or 4g"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    }
  }
}
