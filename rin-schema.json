{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rin Swarm Agent Configuration",
  "description": "Declarative configuration for a cluster of Rin swarm agent. Rin Tohsaka is the best waifu btw",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rin",
    "name",
    "agents",
    "version"
  ],
  "properties": {
    "rin": {
      "type": "string",
      "const": "tohsaka"
    },
    "name": {
      "type": "string",
      "description": "The name of workspace, you can use multiple workspace with Rin",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Rin version to use. If not provided, the latest one will be used"
    },
    "messaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*m$",
          "default": "30m"
        },
        "maxHops": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent"
      },
      "contains": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "leader"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "resources",
        "harness",
        "authentication",
        "model"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$",
          "not": {
            "enum": [
              "user",
              "hub",
              "bifrost"
            ]
          }
        },
        "type": {
          "enum": [
            "leader",
            "member"
          ]
        },
        "label": {
          "type": "string",
          "description": "Like AI Engineer or Universe Engineer or some cool fancy title you can imagine"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "harness": {
          "enum": [
            "claude-code",
            "codex",
            "antigravity",
            "pi"
          ]
        },
        "authentication": {
          "enum": [
            "subscription",
            "apiKey"
          ]
        },
        "model": {
          "type": "string"
        },
        "maxSessions": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        }
      },
      "if": {
        "properties": {
          "harness": {
            "const": "pi"
          }
        },
        "required": [
          "harness"
        ]
      },
      "then": {
        "properties": {
          "authentication": {
            "const": "apiKey"
          }
        },
        "required": [
          "authentication"
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "ram"
      ],
      "properties": {
        "cpus": {
          "type": "number",
          "description": "CPU limit for the agent's container, in cores (Compose cpus), e.g. 2 or 0.5"
        },
        "ram": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[mg]$",
          "description": "Memory limit for the agent's container (Compose mem_limit), e.g. 512m or 4g"
        }
      }
    }
  }
}
